---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found" description="The page you were looking for doesn't exist." noindex={true}>
  <section class="container page-head" style="text-align:center">
    <span class="eyebrow">Missing piece</span>
    <h1>This token fell under the table.</h1>
    <p class="lead" style="margin-inline:auto">That page doesn’t exist. <a href="/">Pick your game</a> instead.</p>
  </section>
</Layout>
