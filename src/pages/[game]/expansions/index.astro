---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import GameBox from '../../../components/GameBox.astro';
import Verdict from '../../../components/Verdict.astro';
import BuyLinks from '../../../components/BuyLinks.astro';
import { games, expansionsFor, TYPE_LABELS, complexityText, styleText } from '../../../lib/catalog.mjs';
import { rankNext, prereqChain, comparePairs, compareTop, playersText, priceBand, VERDICTS, STYLES } from '../../../lib/guide.mjs';
import { relatedGames, hubFaqs, publisherGroups, publisherSlug } from '../../../lib/related.mjs';
import summaries from '../../../data/listing-summaries.json';
import { SITE } from '../../../lib/site.config.mjs';
import { WATCH_OUT } from '../../../lib/game-art.mjs';
import { hubTitle, hubDescription, hubModifiedLd, hubIntro } from '../../../lib/hub-seo.mjs';
import editorial from '../../../data/editorial.json';
import { webApplicationLd, breadcrumbLd, itemListLd, faqPageLd } from '../../../lib/seo.mjs';

export function getStaticPaths() {
  return games.map((game) => ({ params: { game: game.slug }, props: { game } }));
}
const { game } = Astro.props;
// Listing cards use short hand-written summaries; full text lives on each expansion's own page.
const brief = (e, key) => (summaries[`${game.slug}/${e.slug}`] || {})[key] || e[key];
const all = expansionsFor(game.slug);
const { next, unrated } = rankNext(all);
const pairs = comparePairs(all, compareTop(game.slug));
const faqs = hubFaqs(game, all);
const related = relatedGames(game, games);
const pubHub = publisherGroups(games).find((p) => p.name === game.publisher);
const watch = WATCH_OUT[game.slug] || [];
const path = `/${game.slug}/expansions/`;
const top = next[0];
const title = hubTitle(game.name);
const description = hubDescription(game.name, top?.name);
const intro = hubIntro(game, all);
const introText = editorial[game.slug] || intro.slice(0, 2).join(' ') || game.oneLine;
const crumbs = [{ name: 'Games', href: '/' }, { name: `${game.name} expansions` }];

// Minimal data for the browser island.
const islandData = all.map((e) => ({
  id: e.id, slug: e.slug, name: e.name, verdict: e.verdict, buyOrder: e.buyOrder,
  requires: e.requires, minPlayers: e.minPlayers, maxPlayers: e.maxPlayers, groupStyle: e.groupStyle,
}));
const maxPlayers = Math.max(game.maxPlayers || 0, ...all.map((e) => e.maxPlayers || 0)) || 6;
const playerOptions = Array.from({ length: maxPlayers }, (_, i) => i + 1);
---
<Layout
  title={title}
  description={description}
  path={path}
  jsonLdNodes={[
    webApplicationLd({ name: `${game.name} expansion buying guide`, description, url: path }),
    breadcrumbLd(crumbs),
    hubModifiedLd(game.checkedOn, path),
    itemListLd(next.map((e) => ({ url: `/${game.slug}/${e.slug}/`, name: e.name }))),
    faqs.length ? faqPageLd(faqs) : null,
  ]}
>
  <Breadcrumbs items={crumbs} />
  <section class="container">
    <div class="game-head hub-head">
      <GameBox slug={game.slug} size="lg" />
      <div>
        <h1>{game.name} Expansions Ranked: Which to Buy First</h1>
        <p class="lead" style="margin:0" data-hub-intro>{introText}</p>
        <button type="button" class="lead-more" data-lead-more>Read more</button>
        <div class="facts">
          {game.minPlayers && <span class="pill">Base game: {game.minPlayers}–{game.maxPlayers} players</span>}
          {game.playTime && <span class="pill">{game.playTime}</span>}
          {game.publisher && <span class="pill">{game.publisher}</span>}
          <span class="pill">{all.length} expansions checked</span>
        </div>
        {game.buyLinks?.length > 0 && (
          <p class="small" style="margin:var(--space-3) 0 0">
            <strong>Don’t own the base game yet?</strong>{' '}
            <BuyLinks links={game.buyLinks} compact name={`${game.name} base game`} />
          </p>
        )}
      </div>
    </div>

    <div class="tool" data-guide data-game={game.slug} data-storage-key={`${SITE.storagePrefix}${game.slug}`}>
      <nav class="hub-nav" aria-label="On this page">
        <button type="button" class="filter-pill" data-filter-open aria-controls="shelf" aria-expanded="false">Filter<span data-filter-summary>: I own…</span></button>
        <a href="#ranking">Ranking</a>
        {watch.length > 0 && <a href="#watch-h">Check before you buy</a>}
        {pairs.length > 0 && <a href="#cmp-h">Compare</a>}
        {faqs.length > 0 && <a href="#faq-h">FAQ</a>}
      </nav>
      <div class="sheet-backdrop" data-filter-close></div>
      <aside class="shelf token pad" id="shelf" aria-labelledby="shelf-h">
        <h2 id="shelf-h">Your shelf</h2>
        <button type="button" class="sheet-close" data-filter-close>Done</button>
        <fieldset>
          <legend>What do you already own?</legend>
          <div class="own-list">
            {next.map((e) => (
              <label class="own-item">
                <input type="checkbox" name="own" value={e.slug} />
                <span>{e.name}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <fieldset>
          <legend>How many people usually play?</legend>
          <select name="players" class="chip" aria-label="Number of players">
            <option value="">Any number</option>
            {playerOptions.map((n) => <option value={n}>{n} {n === 1 ? 'player' : 'players'}</option>)}
          </select>
        </fieldset>
        <fieldset>
          <legend>Who do you play with?</legend>
          <div class="chip-group" role="group">
            <button type="button" class="chip" data-style="" aria-pressed="true">Anyone</button>
            {Object.entries(STYLES).map(([k, label]) => <button type="button" class="chip" data-style={k} aria-pressed="false">{label}</button>)}
          </div>
        </fieldset>
        <div class="shelf-actions">
          <button type="button" class="btn btn--sm" data-copy>Copy my link</button>
          <button type="button" class="btn btn--sm btn--ghost" data-reset>Clear</button>
        </div>
        <p class="small muted" style="margin:var(--space-3) 0 0" data-copy-status aria-live="polite">Saved on this device only. No account.</p>
      </aside>

      <div>
        <h2 class="visually-hidden">Buy order</h2>
        <p class="track-status visually-hidden" data-status aria-live="polite">
          {top ? <>Start with <a href={`/${game.slug}/${top.slug}/`}>{top.name}</a>.</> : 'We haven’t ranked these yet.'}
        </p>
        <ol class="track" id="ranking" data-track>
          {next.map((e) => {
            const tone = VERDICTS[e.verdict].tone;
            const chain = prereqChain(e, all);
            const orRule = e.listNote;
            const players = playersText(e);
            const price = priceBand(e);
            return (
              <li class="step" data-slug={e.slug} data-tone={tone}>
                <span class="space" aria-hidden="true" data-rank>{e.rank}</span>
                <article class="token card">
                  <div class="card-top">
                    <h3><span class="visually-hidden" data-rank-text>Number {e.rank}: </span><a href={`/${game.slug}/${e.slug}/`}>{e.name}</a></h3>
                    <Verdict verdict={e.verdict} />
                  </div>
                  {e.adds && <p><strong>Adds:</strong> {brief(e, 'adds')}</p>}
                  {e.fixes && <p><strong>Fixes:</strong> {brief(e, 'fixes')}</p>}
                  {e.reason && <p class="muted card-reason">{brief(e, 'reason')}</p>}
                  <div class="needs" data-needs hidden={!chain.length}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 23 21H1z" fill="#F2B705" stroke="#1D2A44" stroke-width="2" /><path d="M12 9v5M12 17v.5" stroke="#1D2A44" stroke-width="2.4" stroke-linecap="round" /></svg>
                    <span>Get <span data-needs-list>{chain.map((c) => c.name).join(' and ')}</span> first.</span>
                  </div>
                  {orRule && <div class="needs"><span>{orRule}</span></div>}
                  <p class="offstyle-note">Usually a better fit for a different kind of group — still fine if it sounds fun.</p>
                  <div class="meta">
                    <span class="pill">{TYPE_LABELS[e.type] || 'Expansion'}</span>
                    {players && <span class="pill">{players} players</span>}
                    {complexityText(e.complexity) && <span class="pill">{complexityText(e.complexity)}</span>}
                    {styleText(e.groupStyle) && <span class="pill">{styleText(e.groupStyle)}</span>}
                    {price && <span class="pill">Price: {price}</span>}
                  </div>
                  <div class="actions">
                    <label class="own-item"><input type="checkbox" name="own-inline" value={e.slug} /> I own this<span class="visually-hidden">: {e.name}</span></label>
                    <a href={`/${game.slug}/${e.slug}/`}>Details</a>
                    <BuyLinks links={e.buyLinks} compact name={e.name} moreHref={`/${game.slug}/${e.slug}/#buy`} />
                  </div>
                  <button type="button" class="row-toggle" data-row-toggle aria-expanded="false"><span data-row-toggle-text>More</span><span class="visually-hidden"> about {e.name}</span></button>
                </article>
              </li>
            );
          })}
        </ol>
        <div class="token empty" data-empty hidden>
          <strong>You own everything we rank.</strong> Nice shelf. Check the list below for the rest.
        </div>
        <p class="muted small hidden-note" data-hidden-note hidden></p>

        {next.length > 0 && (
          <details class="fold section glance">
            <summary><h2 id="tbl-h">{game.name} expansions ranked at a glance</h2></summary>
            <div style="overflow-x:auto">
              <table data-ranked-table>
                <thead>
                  <tr><th scope="col">Rank</th><th scope="col">Expansion</th><th scope="col">Adds</th><th scope="col">Needs</th><th scope="col">Price / buy</th></tr>
                </thead>
                <tbody>
                  {next.map((e) => {
                    const chain = prereqChain(e, all);
                    const price = priceBand(e);
                    return (
                      <tr>
                        <td>{e.rank}</td>
                        <th scope="row"><a href={`/${game.slug}/${e.slug}/`}>{e.name}</a></th>
                        <td>{brief(e, 'adds')}</td>
                        <td>{chain.length ? `${chain.map((c) => c.name).join(' and ')} first` : (e.listNote || 'Base game only')}</td>
                        <td>{price && <>{price} · </>}<BuyLinks links={e.buyLinks} compact name={e.name} moreHref={`/${game.slug}/${e.slug}/#buy`} /></td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </details>
        )}

        {watch.length > 0 && (
          <section class="token pad gotcha section" aria-labelledby="watch-h" data-fold>
            <h2 id="watch-h">Check before you buy</h2>
            <ul style="margin:0;padding-left:1.2rem">{watch.map((w) => <li>{w}</li>)}</ul>
          </section>
        )}

        {pairs.length > 0 && (
          <section class="section" aria-labelledby="cmp-h" data-fold>
            <h2 id="cmp-h" class="mini-h">Stuck between two?</h2>
            <ul class="chips">
              {pairs.map(([a, b]) => (
                <li><a href={`/compare/${game.slug}/${a.slug}-vs-${b.slug}/`}>{a.name} vs {b.name}</a></li>
              ))}
            </ul>
          </section>
        )}

        {unrated.length > 0 && (
          <details class="fold section">
            <summary><h2 id="later-h">Also out there (not ranked yet) · {unrated.length}</h2></summary>
            <p class="muted">We found these but don’t have enough solid reviews to rank them yet.</p>
            <ul class="later-list">
              {unrated.map((e) => (
                <li><a href={`/${game.slug}/${e.slug}/`}><strong>{e.name}</strong></a>{e.adds && <> — {e.adds}</>}</li>
              ))}
            </ul>
          </details>
        )}
        {faqs.length > 0 && (
          <section class="section" aria-labelledby="faq-h" data-fold>
            <h2 id="faq-h" class="mini-h">{game.name} expansions: quick answers</h2>
            <div class="faq-list">
              {faqs.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        <section class="section" aria-labelledby="rel-h" data-fold>
          <h2 id="rel-h" class="mini-h">Other games’ expansion guides</h2>
          <ul class="chips">
            {related.map((g) => <li><a href={`/${g.slug}/expansions/`}>{g.name}</a></li>)}
            {pubHub && <li><a href={`/publishers/${pubHub.slug}/`}>All {pubHub.name} games</a></li>}
          </ul>
        </section>
        <p class="draft-note section">Rankings are our editorial picks, built from the reviews linked on each expansion page. Last checked {game.checkedOn}.</p>
      </div>
    </div>
  </section>
  <script type="application/json" id="guide-data" set:html={JSON.stringify(islandData).replace(/</g, '\\u003c')} />
</Layout>

<script>
  import { rankNext, statusFor, parseState, serializeState, STYLES } from '../../../lib/guide.mjs';

  const root = document.querySelector('[data-guide]');
  const data = JSON.parse(document.getElementById('guide-data').textContent);
  const game = root.dataset.game;
  const key = root.dataset.storageKey;
  const slugs = data.map((e) => e.slug);
  const steps = new Map([...root.querySelectorAll('.step')].map((el) => [el.dataset.slug, el]));

  let state;
  if (/[?&](own|p|style)=/.test(location.search)) state = parseState(location.search, slugs);
  else {
    try { state = parseState(localStorage.getItem(key) || '', slugs); } catch { state = parseState('', slugs); }
  }

  const statusEl = root.querySelector('[data-status]');
  const hiddenNote = root.querySelector('[data-hidden-note]');
  const emptyEl = root.querySelector('[data-empty]');
  const playersSel = root.querySelector('select[name="players"]');
  const filterSummary = root!.querySelector('[data-filter-summary]')!;

  function render() {
    const r = rankNext(data, state);
    const visible = new Map(r.next.map((e) => [e.slug, e]));
    for (const [slug, el] of steps) {
      const row = visible.get(slug);
      el.hidden = !row;
      if (!row) continue;
      el.querySelector('[data-rank]').textContent = row.rank;
      el.querySelector('[data-rank-text]').textContent = `Number ${row.rank}: `;
      el.classList.toggle('is-offstyle', !row.fitsStyle);
      const needs = el.querySelector('[data-needs]');
      needs.hidden = row.blockedBy.length === 0;
      if (row.blockedBy.length) needs.querySelector('[data-needs-list]').textContent = row.blockedBy.map((b) => b.name).join(' and ');
    }
    const status = statusFor(r, state);
    if (status.text) statusEl.textContent = status.text;
    else {
      const a = document.createElement('a');
      a.href = `/${game}/${status.pick.slug}/`;
      a.textContent = status.pick.name;
      statusEl.replaceChildren(status.lead, a, '.');
    }
    emptyEl.hidden = r.next.length > 0 || r.hidden.length > 0;
    hiddenNote.hidden = r.hidden.length === 0;
    hiddenNote.textContent = r.hidden.length
      ? `Hidden because they don’t work at ${state.players} players: ${r.hidden.map((e) => e.name).join(', ')}.`
      : '';
    for (const box of root.querySelectorAll('input[name="own"], input[name="own-inline"]')) box.checked = state.owned.includes(box.value);
    playersSel.value = state.players ? String(state.players) : '';
    for (const chip of root.querySelectorAll('[data-style]')) chip.setAttribute('aria-pressed', String((chip.dataset.style || null) === state.style));
    const qs = serializeState(state);
    try { localStorage.setItem(key, qs); } catch {}
    history.replaceState(null, '', (qs ? `?${qs}` : location.pathname) + location.hash);
    const bits: string[] = [];
    if (state.owned.length) bits.push(`${state.owned.length} owned`);
    if (state.players) bits.push(`${state.players} ${state.players === 1 ? 'player' : 'players'}`);
    if (state.style) bits.push(STYLES[state.style as keyof typeof STYLES]);
    filterSummary.textContent = bits.length ? `: ${bits.join(', ')}` : ': I own…';
  }

  root.addEventListener('change', (ev) => {
    const t = ev.target;
    if (t.name === 'own' || t.name === 'own-inline') {
      const set = new Set(state.owned);
      t.checked ? set.add(t.value) : set.delete(t.value);
      state.owned = slugs.filter((s) => set.has(s));
    } else if (t.name === 'players') state.players = t.value ? Number(t.value) : null;
    render();
  });
  root.addEventListener('click', async (ev) => {
    const t = ev.target.closest('button');
    if (!t) return;
    if (t.hasAttribute('data-style')) state.style = t.dataset.style || null;
    else if (t.hasAttribute('data-reset')) state = { owned: [], players: null, style: null };
    else if (t.hasAttribute('data-copy')) {
      const msg = root.querySelector('[data-copy-status]');
      try { await navigator.clipboard.writeText(location.href); msg.textContent = 'Link copied. Anyone who opens it sees your list.'; }
      catch { msg.textContent = location.href; }
      return;
    } else return;
    render();
  });
  render();

  // ---- Phone layout (≤767px): expandable rows, shelf bottom sheet, folding sections ----
  const phone = matchMedia('(max-width: 767px)');
  const hub = root as HTMLElement;

  function setRow(step: Element, open: boolean) {
    step.classList.toggle('is-open', open);
    const btn = step.querySelector('[data-row-toggle]')!;
    btn.setAttribute('aria-expanded', String(open));
    btn.querySelector('[data-row-toggle-text]')!.textContent = open ? 'Less' : 'More';
  }
  hub.querySelector('[data-track]')!.addEventListener('click', (ev) => {
    const target = ev.target as Element;
    const step = target.closest('.step');
    if (!step || !phone.matches) return;
    if (target.closest('[data-row-toggle]')) return setRow(step, !step.classList.contains('is-open'));
    // Tapping a collapsed row anywhere but a link/control opens it.
    if (!step.classList.contains('is-open') && !target.closest('a, button, input, label, select')) setRow(step, true);
  });

  const shelf = hub.querySelector<HTMLElement>('.shelf')!;
  const backdrop = hub.querySelector('.sheet-backdrop')!;
  const pill = hub.querySelector<HTMLElement>('[data-filter-open]')!;
  function setSheet(open: boolean) {
    shelf.classList.toggle('is-open', open);
    backdrop.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('sheet-open', open);
    pill.setAttribute('aria-expanded', String(open));
    if (open) { shelf.setAttribute('role', 'dialog'); shelf.setAttribute('aria-modal', 'true'); shelf.tabIndex = -1; shelf.focus(); }
    else { shelf.removeAttribute('role'); shelf.removeAttribute('aria-modal'); shelf.removeAttribute('tabindex'); }
  }
  function closeSheet() { setSheet(false); pill.focus(); }
  pill.addEventListener('click', () => setSheet(true));
  for (const el of hub.querySelectorAll('[data-filter-close]')) el.addEventListener('click', closeSheet);
  document.addEventListener('keydown', (ev) => {
    if (!shelf.classList.contains('is-open')) return;
    if (ev.key === 'Escape') return closeSheet();
    if (ev.key !== 'Tab') return;
    // Keep keyboard focus inside the open sheet.
    const items = [...shelf.querySelectorAll<HTMLElement>('button, input, select, a[href]')].filter((el) => el.offsetParent);
    const first = items[0], last = items[items.length - 1];
    if (ev.shiftKey && (document.activeElement === first || document.activeElement === shelf)) { ev.preventDefault(); last.focus(); }
    else if (!ev.shiftKey && document.activeElement === last) { ev.preventDefault(); first.focus(); }
  });

  const folds = [...hub.querySelectorAll('[data-fold]')];
  function setFold(fold: Element, open: boolean) {
    fold.classList.toggle('is-open', open);
    fold.querySelector('.fold-toggle')?.setAttribute('aria-expanded', String(open));
  }
  // Heading buttons exist only on phones so laptop keyboard users get no dead tab stops.
  function applyLayout() {
    for (const fold of folds) {
      const h = fold.querySelector('h2')!;
      const btn = h.querySelector('.fold-toggle');
      if (phone.matches && !btn) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'fold-toggle';
        b.setAttribute('aria-expanded', String(fold.classList.contains('is-open')));
        b.append(...h.childNodes);
        h.append(b);
      } else if (!phone.matches && btn) {
        h.replaceChildren(...btn.childNodes);
        setFold(fold, false);
      }
    }
    if (!phone.matches) {
      for (const step of steps.values()) setRow(step, false);
      if (shelf.classList.contains('is-open')) setSheet(false);
    }
  }
  hub.addEventListener('click', (ev) => {
    const fold = (ev.target as Element).closest('.fold-toggle')?.closest('[data-fold]');
    if (fold) setFold(fold, !fold.classList.contains('is-open'));
  });
  function openFoldFor(hash: string) {
    const target = hash.length > 1 && document.getElementById(decodeURIComponent(hash.slice(1)));
    const fold = target && target.closest('[data-fold]');
    if (fold && phone.matches) setFold(fold, true);
  }
  window.addEventListener('hashchange', () => openFoldFor(location.hash));
  hub.querySelector('.hub-nav')!.addEventListener('click', (ev) => {
    const a = (ev.target as Element).closest('a[href^="#"]');
    if (a) openFoldFor(a.getAttribute('href')!);
  });

  const lead = document.querySelector<HTMLElement>('[data-hub-intro]')!;
  const leadMore = document.querySelector<HTMLElement>('[data-lead-more]')!;
  function fitLead() {
    if (!lead.classList.contains('is-open')) leadMore.hidden = lead.scrollHeight <= lead.clientHeight + 1;
  }
  leadMore.addEventListener('click', () => {
    lead.classList.add('is-open');
    leadMore.hidden = true;
    lead.tabIndex = -1;
    lead.focus();
  });

  applyLayout();
  fitLead();
  openFoldFor(location.hash);
  phone.addEventListener('change', applyLayout);
  window.addEventListener('resize', fitLead);
</script>
