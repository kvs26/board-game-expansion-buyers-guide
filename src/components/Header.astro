---
/**
 * Header.astro — app-shell header: CSS/text wordmark (zero-asset default,
 * recolors per skin), primary nav, optional light/dark toggle.
 * Swap the .mark span for an inline <svg fill="currentColor"> to upgrade the
 * logo without touching layout (research/09 §3).
 */
import { SITE } from '../lib/site.config.mjs';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <span class="mark" aria-hidden="true">
        <!-- Inline-SVG logo upgrade slot: replace with a real mark, keeps currentColor theming. -->
        <svg width="34" height="34" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M16 1.5 29 9v14l-13 7.5L3 23V9z" fill="#F2B705" stroke="#FFFDF8" stroke-width="2" />
          <path d="M16 6 25 11.2v9.6L16 26l-9-5.2v-9.6z" fill="none" stroke="#1D2A44" stroke-width="1.2" stroke-dasharray="2 2" />
          <path d="M16 10.5v11M10.5 16h11" stroke="#1D2A44" stroke-width="3.2" stroke-linecap="round" />
        </svg>
      </span>
      <span>{SITE.name}</span>
    </a>

    <div class="header-actions">
      <button type="button" class="menu-toggle" data-menu-toggle aria-label="Menu" aria-controls="site-nav" aria-expanded="false"></button>
      <nav class="site-nav" id="site-nav" aria-label="Primary">
        {SITE.nav.map((item) => {
          const href = item.href.replace(/\/$/, '') || '/';
          const current = href === path ? 'page' : undefined;
          return <a href={item.href} aria-current={current}>{item.label}</a>;
        })}
      </nav>

      {SITE.enableDarkModeToggle && (
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36A5.5 5.5 0 0 1 12 3z" />
          </svg>
        </button>
      )}
    </div>
  </div>
</header>

<script>
  // Phones (≤767px, see base.css): the nav is a drop-down behind the Menu button.
  const header = document.querySelector<HTMLElement>('.site-header');
  const menuBtn = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  if (header && menuBtn) {
    const setMenu = (open: boolean) => {
      header.classList.toggle('is-menu-open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
    };
    menuBtn.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && header.classList.contains('is-menu-open')) { setMenu(false); menuBtn.focus(); }
    });
    document.addEventListener('click', (ev) => {
      if (header.classList.contains('is-menu-open') && !header.contains(ev.target as Node)) setMenu(false);
    });
  }
</script>
