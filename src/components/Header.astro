---
/**
 * Header.astro — app-shell header: CSS/text wordmark (zero-asset default,
 * recolors per skin), primary nav, optional light/dark toggle.
 * Swap the .mark span for an inline <svg fill="currentColor"> to upgrade the
 * logo without touching layout (research/09 §3).
 */
import { SITE } from '../lib/site.config.mjs';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <span class="mark" aria-hidden="true">
        <!-- Brand mark (fanned cards, picked card carries a meeple). Source: scripts/make-icons.mjs -->
        <svg width="34" height="34" viewBox="50 54 412 412" aria-hidden="true">
          <g transform="rotate(-20 256 450)"><rect x="168" y="124" width="176" height="248" rx="24" fill="#5BC0BE" stroke="#1D2A44" stroke-width="12" /></g>
          <g transform="rotate(20 256 450)"><rect x="168" y="124" width="176" height="248" rx="24" fill="#F3E3C3" stroke="#1D2A44" stroke-width="12" /></g>
          <rect x="168" y="124" width="176" height="248" rx="24" fill="#FF6B4A" stroke="#1D2A44" stroke-width="12" />
          <path transform="translate(184 175) scale(1.44)" fill="#FBF6EC" d="M50 6C60 6 66 13 66 21c0 6-3 10-7 13 11 2 22 5 34 3 4 0 5 5 2 8-7 6-15 9-23 10 4 10 10 22 18 32 2 4 0 7-5 7H60c-5 0-8-5-10-12-2 7-5 12-10 12H15c-5 0-7-3-5-7 8-10 14-22 18-32-8-1-16-4-23-10-3-3-2-8 2-8 12 2 23-1 34-3-4-3-7-7-7-13C34 13 40 6 50 6Z" />
        </svg>
      </span>
      <span>{SITE.name}</span>
    </a>

    <div class="header-actions">
      <button type="button" class="menu-toggle" data-menu-toggle aria-label="Menu" aria-controls="site-nav" aria-expanded="false"></button>
      <nav class="site-nav" id="site-nav" aria-label="Primary">
        {SITE.nav.map((item) => {
          const href = item.href.replace(/\/$/, '') || '/';
          const current = href === path ? 'page' : undefined;
          return <a href={item.href} aria-current={current}>{item.label}</a>;
        })}
      </nav>

      {SITE.enableDarkModeToggle && (
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle dark mode">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36A5.5 5.5 0 0 1 12 3z" />
          </svg>
        </button>
      )}
    </div>
  </div>
</header>

<script>
  // Phones (≤767px, see base.css): the nav is a drop-down behind the Menu button.
  const header = document.querySelector<HTMLElement>('.site-header');
  const menuBtn = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  if (header && menuBtn) {
    const setMenu = (open: boolean) => {
      header.classList.toggle('is-menu-open', open);
      menuBtn.setAttribute('aria-expanded', String(open));
    };
    menuBtn.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (ev) => {
      if (ev.key === 'Escape' && header.classList.contains('is-menu-open')) { setMenu(false); menuBtn.focus(); }
    });
    document.addEventListener('click', (ev) => {
      if (header.classList.contains('is-menu-open') && !header.contains(ev.target as Node)) setMenu(false);
    });
  }
</script>
